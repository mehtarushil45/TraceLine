# ==============================================================================
# TraceLine Frontend Environment Configuration
# ==============================================================================

# In local development: leave blank or set to '/api' to use Vite proxy
# In production (e.g. Vercel): set to your deployed backend URL (e.g. https://traceline-api.onrender.com)
VITE_API_BASE_URL=/api

# Local dev proxy target (used by Vite dev server when proxying /api)
VITE_DEV_API_TARGET=http://127.0.0.1:8000
