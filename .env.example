# ==============================================================================
# TraceLine Backend Environment Configuration
# ==============================================================================

# Server host and port
HOST=0.0.0.0
PORT=8000

# Path to processed payment network data (defaults to data/processed/payment_network)
TRACELINE_DATA_DIR=data/processed/payment_network

# Allowed CORS origins (comma-separated list, or '*' for permissive)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
